{
    "name": "diff-digest",
    "version": "0.2.0",
    "description": "Compress a git diff into a short, reviewable change spec with a local review UI.",
    "type": "module",
    "private": true,
    "scripts": {
        "setup": "bun scripts/install.ts",
        "typecheck": "tsc -p .",
        "lint": "oxlint --type-aware src test scripts && bun scripts/check-suppressions.ts && prettier --check .",
        "format": "prettier --write .",
        "test": "bun test",
        "verify": "bun run typecheck && bun run lint && bun run test",
        "cli": "bun src/cli/index.ts",
        "build": "bun scripts/build.ts"
    },
    "engines": {
        "bun": ">=1.4.2"
    },
    "dependencies": {
        "@orpc/client": "1.15.4",
        "@orpc/contract": "1.15.4",
        "@orpc/openapi": "1.15.4",
        "@orpc/server": "1.15.4",
        "@orpc/zod": "1.15.4",
        "@stricli/core": "1.3.0",
        "highlight.js": "11.12.0",
        "marked": "18.0.14",
        "mermaid": "12.0.0",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "zod": "4.6.5"
    },
    "devDependencies": {
        "@types/bun": "1.4.2",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "oxlint": "1.86.0",
        "oxlint-tsgolint": "7.0.2003",
        "prettier": "3.9.9",
        "typescript": "7.0.2"
    }
}
