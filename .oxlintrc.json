{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "ignorePatterns": ["scripts/install.mjs"],
    "plugins": ["typescript", "unicorn", "import", "promise", "react"],
    "categories": {
        "correctness": "error",
        "suspicious": "error",
        "perf": "error",
        "pedantic": "error"
    },
    "rules": {
        "typescript/ban-ts-comment": [
            "error",
            {
                "ts-expect-error": true,
                "ts-ignore": true,
                "ts-nocheck": true,
                "ts-check": false
            }
        ],
        "typescript/consistent-type-assertions": [
            "error",
            {
                "assertionStyle": "never"
            }
        ],
        "typescript/consistent-type-imports": "error",
        "typescript/no-explicit-any": "error",
        "typescript/no-non-null-assertion": "error",
        "typescript/no-unsafe-assignment": "error",
        "typescript/no-unsafe-call": "error",
        "typescript/no-unsafe-member-access": "error",
        "typescript/no-unsafe-return": "error",
        "typescript/no-unsafe-argument": "error",
        "typescript/no-floating-promises": "error",
        "typescript/no-misused-promises": "error",
        "typescript/await-thenable": "error",
        "typescript/require-await": "error",
        "typescript/switch-exhaustiveness-check": "error",
        "typescript/strict-boolean-expressions": "error",
        "typescript/no-unnecessary-condition": "error",
        "typescript/prefer-nullish-coalescing": "error",
        "typescript/prefer-readonly-parameter-types": [
            "error",
            {
                "allow": [
                    {
                        "from": "file",
                        "name": "Sha",
                        "path": "src/lib/schemas.ts"
                    }
                ],
                "ignoreInferredTypes": true
            }
        ]
    },
    "overrides": [
        {
            "files": ["src/lib/**"],
            "rules": {
                "no-console": "error",
                "no-restricted-imports": [
                    "error",
                    {
                        "patterns": [
                            {
                                "group": ["**/cli/**", "**/server/**", "**/app/**", "react", "react-dom"],
                                "message": "src/lib must not import other src folders or React."
                            }
                        ]
                    }
                ]
            }
        },
        {
            "files": [
                "src/lib/digest.ts",
                "src/lib/schemas.ts",
                "src/lib/md.ts",
                "src/lib/model.ts",
                "src/lib/render.ts",
                "src/lib/contract.ts",
                "src/lib/schemas-api.ts",
                "src/lib/client.ts",
                "src/lib/review.ts",
                "src/lib/publish/schemas.ts",
                "src/lib/backends/types.ts"
            ],
            "rules": {
                "no-restricted-imports": [
                    "error",
                    {
                        "patterns": [
                            {
                                "group": ["**/cli/**", "**/server/**", "**/app/**", "react", "react-dom"],
                                "message": "src/lib must not import other src folders or React."
                            },
                            {
                                "group": ["node:*", "bun", "bun:*"],
                                "message": "The UI imports this file, so it must not import Node or Bun APIs."
                            }
                        ]
                    }
                ],
                "no-restricted-globals": [
                    "error",
                    {
                        "name": "Bun",
                        "message": "The UI imports this file, so it must not use Bun APIs."
                    },
                    {
                        "name": "process",
                        "message": "The UI imports this file, so it must not use Node APIs."
                    }
                ]
            }
        },
        {
            "files": ["test/**"],
            "rules": {
                "max-lines-per-function": "off"
            }
        },
        {
            "files": ["src/app/**"],
            "rules": {
                "react/react-in-jsx-scope": "off",
                "react-hooks/rules-of-hooks": "error",
                "react-hooks/exhaustive-deps": "error",
                "no-restricted-imports": [
                    "error",
                    {
                        "patterns": [
                            {
                                "group": ["**/cli/**", "**/server/**"],
                                "message": "The UI must not import the CLI or the server."
                            },
                            {
                                "group": ["node:*", "bun", "bun:*"],
                                "message": "The UI runs in the browser: no Node or Bun APIs."
                            },
                            {
                                "group": [
                                    "**/lib/config",
                                    "**/lib/store",
                                    "**/lib/repo",
                                    "**/lib/diff",
                                    "**/lib/files",
                                    "**/lib/payload",
                                    "**/lib/check",
                                    "**/lib/lock",
                                    "**/lib/registry",
                                    "**/lib/paths",
                                    "**/lib/coverage",
                                    "**/lib/frontmatter",
                                    "**/lib/lint",
                                    "**/lib/lint/*",
                                    "**/lib/fmt",
                                    "**/lib/publish/digest",
                                    "**/lib/publish/review",
                                    "**/lib/publish/pull",
                                    "**/lib/publish/context",
                                    "**/lib/backends/deps",
                                    "**/lib/backends/github",
                                    "**/lib/backends/gh",
                                    "**/lib/backends/pr",
                                    "**/lib/backends/local",
                                    "**/lib/backends/registry",
                                    "**/lib/backends/envelope"
                                ],
                                "message": "The UI imports only the pure lib files (spec \u00a73)."
                            }
                        ]
                    }
                ],
                "no-restricted-globals": [
                    "error",
                    {
                        "name": "Bun",
                        "message": "The UI runs in the browser."
                    },
                    {
                        "name": "process",
                        "message": "The UI runs in the browser."
                    }
                ]
            }
        }
    ]
}
